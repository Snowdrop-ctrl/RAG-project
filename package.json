{
  "name": "rag-project",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "setup": "npm install && npm run setup:backend",
    "setup:backend": "cd backend && uv sync",
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run dev -w @rag/frontend",
    "dev:backend": "cd backend && uv run uvicorn app.main:app --reload --port 8000",
    "build": "npm run build -w @rag/frontend",
    "lint": "npm run lint -w @rag/frontend && cd backend && uv run ruff check .",
    "test": "cd backend && uv run pytest"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
